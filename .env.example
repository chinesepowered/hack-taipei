# ---------- OpenAI (required) ----------
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
SHIELD_MODEL=gpt-5.6-luna

# Optional: point the Scam Shield at any OpenAI-compatible endpoint (e.g. a sponsor MaaS).
# Leave blank to use OpenAI for everything.
SHIELD_BASE_URL=
SHIELD_API_KEY=

# ---------- Base Sepolia ----------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# The agent key (with 0x prefix). Deploys the contract and calls pay()/propose(). Needs Base Sepolia ETH.
OWNER_PRIVATE_KEY=
# Family guardians. `pnpm fund` tops them up with gas from the owner. Demo keeps them server-side;
# production would use the family's own wallets or passkeys.
GUARDIAN1_PRIVATE_KEY=
GUARDIAN1_NAME=媽媽
GUARDIAN2_PRIVATE_KEY=
GUARDIAN2_NAME=孫子小凱
GUARDIAN_ETH=0.003

# Filled in by `pnpm deploy`
NEXT_PUBLIC_WALLET_ADDRESS=

# Daily limit in USDC used at deploy time
DAILY_LIMIT_USDC=200
GUARDIAN_THRESHOLD=2

# ---------- GMI Cloud (Track 04 film generation, optional) ----------
GMI_API_KEY=

# ---------- 0G (Zero Gravity) ----------
# Scam Shield on the 0G Compute Router: OpenAI-compatible, every inference TEE-attested (verify_tee).
# Key from https://pc.0g.ai (deposit 0G or pay in USD, then Dashboard → API Keys).
# SHIELD_BASE_URL=https://router-api.0g.ai/v1
# SHIELD_API_KEY=sk-...
# SHIELD_MODEL=0gm-1.0-35b-a3b
# SHIELD_TRUST_MODE=verified        # or `private` (routes only to enclave providers)
# SHIELD_PROVIDER=0g                # optional; auto-detected from the base URL

# Put the guardian wallet on 0G Galileo instead of Base Sepolia (chain id 16602, faucet https://faucet.0g.ai).
# CHAIN=0g-galileo
# NEXT_PUBLIC_CHAIN=0g-galileo
# OG_RPC_URL=https://evmrpc-testnet.0g.ai
# NEXT_PUBLIC_EXPLORER_URL=https://chainscan-galileo.0g.ai
# NEXT_PUBLIC_USDC_ADDRESS=          # from `pnpm deploy:usdc` (no Circle faucet on 0G testnet)

# 豆豆's Agentic ID (ERC-7857) on 0G Galileo. Filled by `pnpm mint-agent`; the stamp carries both.
AGENT_NAME=豆豆
AGENT_ID_CONTRACT=
AGENT_ID_TOKEN=
